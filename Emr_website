<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EMR System</title>
    <style>
        body { font-family: "Georgia", serif; font-size: 18px; background-color: #f8e1e7; color: #654321; text-align: center; }
        .container { width: 80%; margin: auto; padding: 20px; }
        nav { background: #d2a679; padding: 10px; }
        nav a { color: white; text-decoration: none; margin: 15px; font-weight: bold; }
        .section { margin-top: 20px; padding: 20px; background: white; border-radius: 5px; text-align: left; }
        button { background: #d2a679; color: white; padding: 10px; border: none; cursor: pointer; margin-top: 10px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #654321; padding: 10px; text-align: left; }
        input, textarea { width: 100%; padding: 5px; margin-top: 5px; }
    </style>
</head>
<body>

<div class="container">
    <nav>
        <a href="#" onclick="showSection('home')">Home</a>
        <a href="#" onclick="showSection('patients')">Patients</a>
        <a href="#" onclick="showSection('vitals')">Vital Signs</a>
        <a href="#" onclick="showSection('input-output')">Input/Output</a>
        <a href="#" onclick="showSection('lab-results')">Lab Results</a>
    </nav>

    <!-- Home Section -->
    <div id="home" class="section">
        <h1>Welcome to the EMR System</h1>
        <p><strong>Vision & Mission:</strong></p>
        <textarea id="visionMission" rows="4" placeholder="Enter vision and mission..."></textarea>
        <p><strong>Founded by:</strong> Jenuel Salvador, Leroy Lacwasan, Aila Tao-ey, Christian Gosgos</p>
        <button onclick="saveContent('visionMission')">Save</button>
    </div>

    <!-- Patient Profiles -->
    <div id="patients" class="section" style="display: none;">
        <h2>Patient Profiles</h2>
        <button onclick="addPatient()">Add Patient</button>
        <table id="patientTable">
            <tr><th>Name</th><th>Age</th><th>Medical History</th><th>Action</th></tr>
        </table>
    </div>

    <!-- Vital Signs -->
    <div id="vitals" class="section" style="display: none;">
        <h2>Vital Signs</h2>
        <table>
            <tr><th>Heart Rate</th><th>Respiratory Rate</th><th>Blood Pressure</th><th>Temperature</th><th>SPO2</th></tr>
            <tr>
                <td><input type="text" id="heartRate"></td>
                <td><input type="text" id="respRate"></td>
                <td><input type="text" id="bp"></td>
                <td><input type="text" id="temp"></td>
                <td><input type="text" id="spo2"></td>
            </tr>
        </table>
        <button onclick="saveVitals()">Save</button>
    </div>

    <!-- Input and Output -->
    <div id="input-output" class="section" style="display: none;">
        <h2>Input & Output Monitoring</h2>
        <p>Fluids Intake:</p> <input type="text" id="fluidsIntake">
        <p>Stool Output:</p> <input type="text" id="stoolOutput">
        <p>Urine Output:</p> <input type="text" id="urineOutput">
        <button onclick="saveInputOutput()">Save</button>
    </div>

    <!-- Lab Results -->
    <div id="lab-results" class="section" style="display: none;">
        <h2>Lab Results</h2>
        <input type="file" id="labImage">
        <button onclick="uploadImage()">Upload</button>
        <div id="labDisplay"></div>
    </div>
</div>

<script>
    function showSection(section) {
        document.querySelectorAll('.section').forEach(div => div.style.display = 'none');
        document.getElementById(section).style.display = 'block';
    }

    function addPatient() {
        let table = document.getElementById("patientTable");
        let name = prompt("Enter patient name:");
        let age = prompt("Enter patient age:");
        let history = prompt("Enter medical history:");
        
        if (name && age && history) {
            let row = table.insertRow(-1);
            row.insertCell(0).innerText = name;
            row.insertCell(1).innerText = age;
            row.insertCell(2).innerText = history;
            let deleteBtn = document.createElement("button");
            deleteBtn.innerText = "Delete";
            deleteBtn.onclick = function () { row.remove(); };
            row.insertCell(3).appendChild(deleteBtn);
        }
    }

    function saveVitals() {
        alert("Vital signs saved (temporarily). Data resets on page refresh.");
    }

    function saveInputOutput() {
        alert("Input & Output data saved (temporarily).");
    }

    function uploadImage() {
        let fileInput = document.getElementById("labImage");
        let file = fileInput.files[0];
        
        if (file) {
            let reader = new FileReader();
            reader.onload = function (e) {
                let img = document.createElement("img");
                img.src = e.target.result;
                img.style.width = "200px";
                document.getElementById("labDisplay").appendChild(img);
            };
            reader.readAsDataURL(file);
        } else {
            alert("Please select an image.");
        }
    }

    function saveContent(id) {
        alert("Content saved (temporarily). Data resets on refresh.");
    }
</script>

</body>
</html>
